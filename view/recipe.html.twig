{% extends 'base.html.twig' %}

{% block body %}
<main class="bg-[#eae6d8] text-[#30422e]">

    {# PRESENTATION DE LA RECETTE #}
    <section class="mx-auto max-w-[1427px]">
        <div class="grid lg:grid-cols-2">

            {% if recipe.mainPic %}
                <img
                    src="{{ recipe.mainPic }}"
                    alt="{{ recipe.recipeTitle }}"
                    class="h-full max-h-[650px] w-full object-cover"
                >
            {% endif %}

            <div class="flex flex-col justify-center
                        bg-[#d7d5c2] p-8 md:p-16">

                <h1 class="font-serif text-4xl md:text-6xl">
                    {{ recipe.recipeTitle }}
                </h1>

                <p class="mt-6 text-lg">
                    {{ recipe.recipeDescription }}
                </p>

                <p id="recipe-header-rating" class="mt-6 text-[#a78337]">
                    {% if vote_count > 0 %}
                        ★ {{ average_rating|number_format(1) }}/5
                        ({{ vote_count }} avis)
                    {% else %}
                        Pas encore de note
                    {% endif %}
                </p>

                <div class="mt-8 grid grid-cols-2 gap-4
                            border-t border-[#b68d32] pt-6">
                    <p>Préparation : {{ recipe.prepTime }} min</p>
                    <p>Cuisson : {{ recipe.cookingTime }} min</p>
                    <p>Total : {{ total_time }} min</p>
                    <p>Difficulté : {{ recipe.difficulty|capitalize }}</p>
                    <p>Portions : {{ recipe.portion }}</p>
                </div>
            </div>
        </div>
    </section>


    {# INGREDIENTS ET ETAPES #}
    <section class="mx-auto max-w-6xl px-6 py-16">

        <div class="grid gap-12 lg:grid-cols-3">

            {# INGREDIENTS #}
            <aside class="bg-[#a7ad8d] p-8">
                <h2 class="mb-8 border-b border-[#b68d32]
                           pb-4 font-serif text-3xl">
                    Ingrédients
                </h2>

                <ul class="space-y-4">
                    {% for ingredient in recipe.ingredients|default([]) %}
                        <li class="border-b border-[#30422e]/20 pb-3">
                            {% if ingredient.recipeIngredientQuantity is not null %}
                                {{ ingredient.recipeIngredientQuantity }}
                            {% endif %}
                            {{ ingredient.recipeIngredientUnity }}
                            {{ ingredient.ingredientName }}
                        </li>
                    {% endfor %}
                </ul>
            </aside>

            {# ETAPES #}
            <div class="lg:col-span-2">
                <h2 class="mb-8 border-b border-[#b68d32]
                           pb-4 font-serif text-3xl">
                    Étapes de préparation
                </h2>

                {% for step in recipe.steps|default([]) %}
                    <article class="mb-10 border-b border-[#b68d32]
                                    pb-10">
                        <div class="grid items-center gap-6 md:grid-cols-2">

                            <div>
                                <h3 class="mb-4 font-serif text-2xl">
                                    Étape {{ step.stepOrder }}
                                    — {{ step.stepTitle }}
                                </h3>
                                <p class="leading-relaxed">
                                    {{ step.stepTexte }}
                                </p>
                            </div>

                            {% if step.stepPic %}
                                <img
                                    src="{{ step.stepPic }}"
                                    alt="Étape {{ step.stepOrder }} : {{ step.stepTitle }}"
                                    class="aspect-[3/2] w-full
                                           rounded-[50%] object-cover"
                                    loading="lazy"
                                >
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}

                <p class="font-serif text-3xl italic">
                    Bonne dégustation !
                </p>
            </div>

        </div>
    </section>

    {# rating #}
    {% include 'template/rating.html.twig' %}

    {# COMMENTAIRES #}
    {% include 'template/comments.html.twig' %}

    {# AUTRES RECETTES À DÉCOUVRIR #}
    {% if other_recipes|default([]) is not empty %}

    <section class="mx-auto max-w-6xl px-6 py-16">

        <h2 class="mb-10 text-center font-serif text-3xl">
            D'autres recettes à découvrir
        </h2>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">

            {% for otherRecipe in other_recipes %}

                <article class="overflow-hidden rounded-xl
                                bg-[#d7d5c2]">

                    <a href="?pg=recipe&amp;slug={{ otherRecipe.getRecipeSlugTitle()|url_encode }}"
                    class="block">

                        {% if otherRecipe.getMainPic() %}

                            <img
                                src="{{ otherRecipe.getMainPic() }}"
                                alt="{{ otherRecipe.getRecipeTitle() }}"
                                class="aspect-[4/3] w-full object-cover"
                                loading="lazy"
                            >

                        {% else %}

                            <div class="flex aspect-[4/3]
                                        items-center justify-center
                                        bg-[#a7ad8d]">
                                Photo à venir
                            </div>

                        {% endif %}

                        <div class="p-6">

                            <h3 class="font-serif text-2xl">
                                {{ otherRecipe.getRecipeTitle() }}
                            </h3>

                            <span class="mt-4 inline-block
                                        text-[#481915] underline">
                                Voir la recette →
                            </span>

                        </div>

                    </a>

                </article>

            {% endfor %}

        </div>

    </section>

    {% endif %}

    {# RETOUR AUX RECETTES #}
    <div class="pb-12 text-center">
        <a href="?pg=recipes"
        class="inline-block rounded-full bg-[#481915]
                px-8 py-3 text-white">
            Retour aux recettes
        </a>
    </div>

</main>
<script src="assets/js/rating.js" defer></script>
<script src="assets/js/comments.js" defer></script>
{% endblock %}
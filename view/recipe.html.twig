{% extends 'base.html.twig' %}

{% block body %}
<main class="bg-[#eae6d8] text-[#30422e]">

    {# PRESENTATION DE LA RECETTE #}
    <section class="mx-auto max-w-[1427px]">
        <div class="grid lg:grid-cols-2">

            {% if recipe.mainPic %}
                <img
                    src="{{ recipe.mainPic }}"
                    alt="{{ recipe.recipeTitle }}"
                    class="h-full max-h-[650px] w-full object-cover"
                >
            {% endif %}

            <div class="flex flex-col justify-center
                        bg-[#d7d5c2] p-8 md:p-16">

                <h1 class="font-serif text-4xl md:text-6xl">
                    {{ recipe.recipeTitle }}
                </h1>

                <p class="mt-6 text-lg">
                    {{ recipe.recipeDescription }}
                </p>

                <p id="recipe-header-rating"class="mt-6 text-[#a78337]">
                    {% if vote_count > 0 %}
                        ★ {{ average_rating|number_format(1) }}/5
                        ({{ vote_count }} avis)
                    {% else %}
                        Pas encore de note
                    {% endif %}
                </p>

                <div class="mt-8 grid grid-cols-2 gap-4
                            border-t border-[#b68d32] pt-6">
                    <p>Préparation : {{ recipe.prepTime }} min</p>
                    <p>Cuisson : {{ recipe.cookingTime }} min</p>
                    <p>Total : {{ total_time }} min</p>
                    <p>Difficulté : {{ recipe.difficulty|capitalize }}</p>
                    <p>Portions : {{ recipe.portion }}</p>
                </div>
            </div>
        </div>
    </section>

    {% include 'template/rating.html.twig' %}

    {# INGREDIENTS ET ETAPES #}
    <section class="mx-auto max-w-6xl px-6 py-16">

        <div class="grid gap-12 lg:grid-cols-3">

            {# INGREDIENTS #}
            <aside class="bg-[#a7ad8d] p-8">
                <h2 class="mb-8 border-b border-[#b68d32]
                           pb-4 font-serif text-3xl">
                    Ingrédients
                </h2>

                <ul class="space-y-4">
                    {% for ingredient in recipe.ingredients|default([]) %}
                        <li class="border-b border-[#30422e]/20 pb-3">
                            {% if ingredient.recipeIngredientQuantity is not null %}
                                {{ ingredient.recipeIngredientQuantity }}
                            {% endif %}
                            {{ ingredient.recipeIngredientUnity }}
                            {{ ingredient.ingredientName }}
                        </li>
                    {% endfor %}
                </ul>
            </aside>

            {# ETAPES #}
            <div class="lg:col-span-2">
                <h2 class="mb-8 border-b border-[#b68d32]
                           pb-4 font-serif text-3xl">
                    Étapes de préparation
                </h2>

                {% for step in recipe.steps|default([]) %}
                    <article class="mb-10 border-b border-[#b68d32]
                                    pb-10">
                        <div class="grid items-center gap-6 md:grid-cols-2">

                            <div>
                                <h3 class="mb-4 font-serif text-2xl">
                                    Étape {{ step.stepOrder }}
                                    — {{ step.stepTitle }}
                                </h3>
                                <p class="leading-relaxed">
                                    {{ step.stepTexte }}
                                </p>
                            </div>

                            {% if step.stepPic %}
                                <img
                                    src="{{ step.stepPic }}"
                                    alt="Étape {{ step.stepOrder }} : {{ step.stepTitle }}"
                                    class="aspect-[3/2] w-full
                                           rounded-[50%] object-cover"
                                    loading="lazy"
                                >
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}

                <p class="font-serif text-3xl italic">
                    Bonne dégustation !
                </p>
            </div>

        </div>
    </section>

    {# AVIS EXISTANTS #}
    <section class="mx-auto max-w-4xl px-6 py-16">
        <h2 class="mb-8 font-serif text-3xl">
            Avis des visiteurs
        </h2>

        {% for comment in comments|default([]) %}
            <article class="mb-6 border-b border-[#b68d32] pb-6">
                <p class="font-semibold">
                    {{ comment.user.userLogin }}
                </p>
                <p class="text-sm">
                    {{ comment.commentDate|date('d/m/Y') }}
                </p>
                <p class="mt-3">
                    {{ comment.commentMessage }}
                </p>
            </article>
        {% else %}
            <p>Aucun commentaire pour le moment.</p>
        {% endfor %}

        <a href="?pg=recipes"
           class="mt-8 inline-block rounded-full
                  bg-[#481915] px-8 py-3 text-white">
            Retour aux recettes
        </a>
    </section>

</main>
<script src="assets/js/rating.js" defer></script>
{% endblock %}
<div id="auth-modal"
     role="dialog"
     aria-modal="true"
     aria-label="Connexion ou inscription"
     class="fixed inset-0 z-[100] hidden items-center justify-center p-4">

    {# FOND SOMBRE #}
    <div class="absolute inset-0 bg-black/60"
         aria-hidden="true"></div>

    <div class="relative z-10 max-h-[90vh] w-full
                max-w-md overflow-y-auto rounded-lg
                bg-[#eae6d8] p-8 text-[#30422e]
                shadow-2xl">

        <button type="button"
                data-auth-close
                aria-label="Fermer"
                class="absolute right-5 top-4 text-2xl">
            &times;
        </button>

        {# CONNEXION #}
        <form id="login-form"
              action="?pg=api-login"
              method="post"
              class="space-y-5">

            <h2 class="mb-8 text-center font-serif text-4xl">
                Connexion
            </h2>

            <input type="hidden" name="_csrf" value="">

            <div>
                <label for="login-name" class="mb-2 block">
                    Nom d'utilisateur
                </label>
                <input id="login-name"
                       name="user_login"
                       type="text"
                       required
                       autocomplete="username"
                       class="w-full border border-[#b68d32]
                              bg-white p-3">
            </div>

            <div>
                <label for="login-password" class="mb-2 block">
                    Mot de passe
                </label>
                <input id="login-password"
                       name="user_pwd"
                       type="password"
                       required
                       autocomplete="current-password"
                       class="w-full border border-[#b68d32]
                              bg-white p-3">
            </div>

            <p id="login-status"
               role="status"
               aria-live="polite"
               class="text-sm"></p>

            <button type="submit"
                    class="w-full rounded-full bg-[#481915]
                           p-3 text-white disabled:opacity-50">
                Se connecter
            </button>

            <p class="text-center text-sm">
                Pas encore de compte ?
                <button type="button"
                        data-auth-switch="register"
                        class="text-[#a78337] underline">
                    S'inscrire
                </button>
            </p>
        </form>

        {# INSCRIPTION #}
        <form id="register-form"
              action="?pg=api-register"
              method="post"
              class="hidden space-y-5">

            <h2 class="mb-8 text-center font-serif text-4xl">
                Inscription
            </h2>

            <input type="hidden" name="_csrf" value="">

            <div>
                <label for="register-name" class="mb-2 block">
                    Nom d'utilisateur
                </label>
                <input id="register-name"
                       name="user_login"
                       type="text"
                       minlength="3"
                       maxlength="45"
                       required
                       autocomplete="username"
                       class="w-full border border-[#b68d32]
                              bg-white p-3">
            </div>

            <div>
                <label for="register-email" class="mb-2 block">
                    Adresse email
                </label>
                <input id="register-email"
                       name="user_email"
                       type="email"
                       maxlength="45"
                       required
                       autocomplete="email"
                       class="w-full border border-[#b68d32]
                              bg-white p-3">
            </div>

            <div>
                <label for="register-password" class="mb-2 block">
                    Mot de passe
                </label>
                <input id="register-password"
                       name="user_pwd"
                       type="password"
                       required
                       autocomplete="new-password"
                       class="w-full border border-[#b68d32]
                              bg-white p-3">
            </div>

            <div>
                <label for="register-confirm" class="mb-2 block">
                    Confirmer le mot de passe
                </label>
                <input id="register-confirm"
                       name="user_pwd_confirm"
                       type="password"
                       required
                       autocomplete="new-password"
                       class="w-full border border-[#b68d32]
                              bg-white p-3">
            </div>

            <p id="register-status"
               role="status"
               aria-live="polite"
               class="text-sm"></p>

            <button type="submit"
                    class="w-full rounded-full bg-[#481915]
                           p-3 text-white disabled:opacity-50">
                Créer mon compte
            </button>

            <p class="text-center text-sm">
                Déjà un compte ?
                <button type="button"
                        data-auth-switch="login"
                        class="text-[#a78337] underline">
                    Se connecter
                </button>
            </p>
        </form>

    </div>
</div>
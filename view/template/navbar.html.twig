<nav class="mr-nav" aria-label="Navigation principale">
    <div class="mr-nav__desktop">
        <a class="mr-nav__link" data-nav-page="home" href="?pg=home">Accueil</a>
        <details class="mr-nav__dropdown">
            <summary class="mr-nav__link" data-nav-page="recipes">Recettes <span aria-hidden="true">⌄</span></summary>
            <div class="mr-nav__submenu">
                <a href="?pg=recipes" class="mr-nav__submenu-title">Toutes les recettes</a>
                {% for item in recipes_menu|default([]) %}
                    <a href="?pg=recipe&amp;slug={{ item.getRecipeSlugTitle()|url_encode }}">
                        {{ item.getRecipeTitle() }}
                    </a>
                {% endfor %}
            </div>
        </details>
        <a class="mr-nav__link" data-nav-page="about" href="?pg=about">À propos</a>
        <a class="mr-nav__link" data-nav-page="contact" href="?pg=contact">Contact</a>
        <div data-auth-guest><button type="button" data-open-login class="mr-nav__auth">Se connecter</button></div>
        <div data-auth-user class="hidden mr-nav__user">
            <span data-auth-name></span>
            <button type="button" data-auth-logout class="mr-nav__auth">Déconnexion</button>
        </div>
        <p data-auth-status class="mr-nav__status" role="status" aria-live="polite"></p>
    </div>
    <details class="mr-nav__mobile">
        <summary aria-label="Afficher le menu principal" class="mr-nav__mobile-trigger">Menu <span aria-hidden="true">☰</span></summary>
        <div class="mr-nav__mobile-panel">
            <a href="?pg=home">Accueil</a>
            <a href="?pg=recipes">Toutes les recettes</a>
            {% for item in recipes_menu|default([]) %}
                <a class="mr-nav__mobile-recipe" href="?pg=recipe&amp;slug={{ item.getRecipeSlugTitle()|url_encode }}">
                    {{ item.getRecipeTitle() }}
                </a>
            {% endfor %}
            <a href="?pg=about">À propos</a>
            <a href="?pg=contact">Contact</a>
            <div data-auth-guest><button type="button" data-open-login class="mr-nav__auth">Se connecter</button></div>
            <div data-auth-user class="hidden mr-nav__user">
                <span data-auth-name></span>
                <button type="button" data-auth-logout class="mr-nav__auth">Déconnexion</button>
            </div>
            <p data-auth-status class="mr-nav__status" role="status" aria-live="polite"></p>
        </div>
    </details>
</nav>

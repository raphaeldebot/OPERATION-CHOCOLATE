{# En-tête commun : les éléments décoratifs cadrent le logo et la navigation. #}
<header class="rosalie-header relative z-20 bg-[#e9e6d8] text-[#30422e]">
    <div class="relative mx-auto h-[375px] w-full max-w-[1427px] md:h-[520px] xl:h-[600px]">

        {# Fleuron doré, centré en haut de la composition. #}
        <img src="assets/images/decorative/top-ornaments.svg"
             alt="" aria-hidden="true"
             class="rosalie-gold-ornament pointer-events-none absolute left-1/2 top-4 h-[105px] w-[190px] -translate-x-1/2 object-contain md:top-9 md:h-[145px] md:w-[270px] xl:top-12" >

        {# Ornements latéraux : centrés sur le contenu, pas sur les bords du navigateur. #}
        <img src="assets/images/decorative/corner-ornament.svg"
             alt="" aria-hidden="true"
             class="rosalie-gold-ornament pointer-events-none absolute left-[6%] top-[165px] hidden h-[200px] w-[180px] object-contain lg:block xl:top-[215px] xl:h-[245px]" >
        <img src="assets/images/decorative/corner-ornament.svg"
             alt="" aria-hidden="true"
             class="rosalie-gold-ornament pointer-events-none absolute right-[6%] top-[165px] hidden h-[200px] w-[180px] scale-x-[-1] object-contain lg:block xl:top-[215px] xl:h-[245px]" >

        {# Boutons de navigation, placés sous le fleuron. #}
        <div class="absolute inset-x-4 top-[103px] z-30 md:top-[155px] xl:top-[190px]">
            {% include 'template/navbar.html.twig' %}
        </div>

        {# Le SVG contient déjà le monogramme ET le nom Maison Rosalie. #}
        <a href="?pg=home"
           aria-label="Maison Rosalie — Accueil"
           class="absolute left-1/2 top-[154px] z-10 block -translate-x-1/2 md:top-[210px] xl:top-[255px]">
            <img src="assets/images/shared/logo-gold.svg"
                 alt="Maison Rosalie"
                 class="h-[220px] w-auto max-w-none object-contain md:h-[280px] xl:h-[325px]" >
        </a>
    </div>
</header>

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Maison Rosalie : chocolat belge et recettes familiales depuis 1987.">
    <title>{{ title|default('Maison Rosalie') }} | Maison Rosalie</title>
    <link rel="icon" type="image/svg+xml" href="assets/images/shared/logo-gold.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet">
    {# IMPORTANT : conserver la feuille générée par le projet #}
    <link rel="stylesheet" href="assets/css/app.css">
    {# CSS additionnel pour la refonte ; aucun rebuild Tailwind nécessaire #}
    <link rel="stylesheet" href="assets/css/rosalie-refonte.css">
</head>
<body class="min-h-screen bg-[#eae6d8] text-[#30422e]">
    {% include 'template/auth-modal.html.twig' %}
    {% include 'template/header.html.twig' %}
    {% block body %}{% endblock %}
    {% include 'template/footer.html.twig' %}
    <script src="assets/js/auth-modal.js" defer></script>
    <script src="assets/js/auth-state.js" defer></script>
    <script src="assets/js/rosalie-refonte.js" defer></script>
</body>
</html>

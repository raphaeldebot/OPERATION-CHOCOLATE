{% extends 'base.html.twig' %}
{% block body %}
<main class="mr-home">
    {# Nouveau visuel livré dans la PR #51 : aucune copie ni modification de l'asset. #}
    <section class="mr-hero" aria-labelledby="mr-home-title">
        <img class="mr-hero__image" src="assets/images/home/recipe-book-hero.webp"
             alt="Carnet de recettes artisanal entouré de chocolat et d'ingrédients"
             fetchpriority="high">
        <div class="mr-hero__overlay" aria-hidden="true"></div>
        <div class="mr-container mr-hero__content">
            <p class="mr-eyebrow mr-eyebrow--light">Maison Rosalie · Chocolaterie belge depuis 1987</p>
            <h1 id="mr-home-title">Des créations d'exception pour des moments précieux</h1>
            <p>Des recettes au chocolat transmises avec passion, de génération en génération.</p>
            <div class="mr-hero__actions">
                <a class="mr-button mr-button--sage" href="?pg=recipes">Découvrir nos recettes <span aria-hidden="true">→</span></a>
                <a class="mr-button mr-button--outline" href="?pg=about">Notre histoire</a>
            </div>
        </div>
    </section>

    <section class="mr-values" aria-label="Les valeurs de la Maison Rosalie">
        <div class="mr-container mr-values__grid">
            <div><span aria-hidden="true">✧</span><strong>Depuis 1987</strong><small>Un savoir-faire familial</small></div>
            <div><span aria-hidden="true">❀</span><strong>Artisanat belge</strong><small>Des gestes transmis</small></div>
            <div><span aria-hidden="true">♧</span><strong>Ingrédients choisis</strong><small>Le goût de l'authenticité</small></div>
            <div><span aria-hidden="true">♡</span><strong>Moments précieux</strong><small>Le plaisir de partager</small></div>
        </div>
    </section>

    <section class="mr-section mr-container" aria-labelledby="mr-top-title">
        <div class="mr-section__heading">
            <div>
                <p class="mr-eyebrow">À découvrir</p>
                <h2 id="mr-top-title">Les 3 recettes les mieux notées</h2>
            </div>
            <a class="mr-text-link" href="?pg=recipes">Voir toutes les recettes <span aria-hidden="true">→</span></a>
        </div>

        {% if top_recipes_error|default(false) %}
            <p class="mr-notice" role="status">Les recettes sont momentanément indisponibles.</p>
        {% else %}
            <div class="mr-card-grid mr-card-grid--top">
                {% for recipe in top_recipes|default([])|slice(0, 3) %}
                    <article class="mr-recipe-card">
                        <a class="mr-recipe-card__media" href="?pg=recipe&amp;slug={{ recipe.recipe_slug_title|url_encode }}">
                            {% if recipe.main_pic|default('') %}
                                <img src="{{ recipe.main_pic }}" alt="{{ recipe.recipe_title }}" loading="lazy">
                            {% else %}
                                <div class="mr-recipe-card__placeholder">Photo à venir</div>
                            {% endif %}
                            <span class="mr-recipe-card__rank">N° {{ loop.index }}</span>
                        </a>
                        <div class="mr-recipe-card__body">
                            <div class="mr-recipe-card__rating">
                                {% if recipe.vote_count|default(0) > 0 %}
                                    <span aria-hidden="true">★</span> {{ recipe.average_rating|number_format(1, ',', ' ') }}/5
                                    <small>({{ recipe.vote_count }} avis)</small>
                                {% else %}
                                    <small>Pas encore de note</small>
                                {% endif %}
                            </div>
                            <h3><a href="?pg=recipe&amp;slug={{ recipe.recipe_slug_title|url_encode }}">{{ recipe.recipe_title }}</a></h3>
                            <p class="mr-recipe-card__facts"><span>◷ {{ recipe.total_time }} min</span><span>{{ recipe.difficulty|capitalize }}</span></p>
                            <a class="mr-text-link" href="?pg=recipe&amp;slug={{ recipe.recipe_slug_title|url_encode }}">Voir la recette <span aria-hidden="true">→</span></a>
                        </div>
                    </article>
                {% else %}
                    <p class="mr-notice">Nos premières recettes seront bientôt disponibles.</p>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="mr-story" aria-labelledby="mr-story-title">
        <div class="mr-container mr-story__grid">
            <div class="mr-story__photo">
                <img src="assets/images/about/family-kitchen-story.webp"
                     alt="La transmission du savoir-faire chocolatier en famille" loading="lazy">
            </div>
            <div class="mr-story__copy">
                <p class="mr-eyebrow">Notre histoire</p>
                <h2 id="mr-story-title">Un héritage gourmand depuis 1987</h2>
                <p>Depuis 1987, la famille Moreau perpétue la tradition des chocolatiers artisanaux belges. Chaque recette est transmise de génération en génération avec amour et savoir-faire.</p>
                <a class="mr-button mr-button--dark" href="?pg=about">Découvrir notre histoire <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block body %}

<main
    class="min-h-screen px-6 py-16 font-serif text-[#30422e] md:px-12"
    style="
        background-color: #a7ad8d;
        background-image:
            linear-gradient(
                rgba(167,173,141,.85),
                rgba(167,173,141,.85)
            ),
            url('assets/images/decorative/background-texture.jpg');
        background-size: cover;
        background-position: center;
    "
>
    <div class="mx-auto max-w-7xl">

        {# TITRE #}
        <header class="mb-14 text-center">

            <h1 class="text-4xl uppercase tracking-wider text-[#b68d32]">
                Recettes
            </h1>

            <p class="mt-3 text-2xl italic md:text-3xl">
                Explorez toutes les recettes de Rosalie
            </p>

        </header>

        {# ÉTATS ERREUR / VIDE #}
        {% if recipes_error|default(false) %}

            <p class="text-center" role="alert">
                Les recettes sont momentanément indisponibles.
            </p>

        {% elseif recipes|default([]) is empty %}

            <p class="text-center">
                Aucune recette disponible pour le moment.
            </p>

        {% else %}

            {# GRILLE DES RECETTES #}
            <section
                class="grid grid-cols-1 gap-x-8 gap-y-16
                       sm:grid-cols-2 lg:grid-cols-4"
                aria-label="Liste des recettes"
            >

                {% for item in recipes %}

                    {% set recipe = item.recipe %}

                    <article class="min-w-0">

                        {# PHOTO #}
                        <a
                            href="?pg=recipe&amp;slug={{ recipe.getRecipeSlugTitle()|url_encode }}"
                            class="block"
                        >

                            {% if recipe.getMainPic() %}

                                <img
                                    src="{{ recipe.getMainPic() }}"
                                    alt="{{ recipe.getRecipeTitle() }}"
                                    class="aspect-[2/3] w-full object-cover"
                                    loading="lazy"
                                >

                            {% else %}

                                <div
                                    class="flex aspect-[2/3] items-center
                                           justify-center bg-[#879271]"
                                >
                                    <span class="text-sm">
                                        Photo à venir
                                    </span>
                                </div>

                            {% endif %}

                        </a>

                        {# CATÉGORIE ET NOTE #}
                        <div
                            class="mt-4 flex flex-wrap items-center gap-3
                                   text-xs uppercase tracking-widest"
                        >

                            <span>
                                {% for category in recipe.getCategories()|default([]) %}
                                    {{ category.getCategoryTitle() }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </span>

                            {% if item.vote_count > 0 %}
                                <span>
                                    ★ {{ item.average_rating|number_format(1, '.', '') }}
                                </span>
                            {% else %}
                                <span>Pas encore de note</span>
                            {% endif %}

                        </div>

                        {# NOM ET CŒUR DÉCORATIF #}
                        <div class="mt-3 flex items-start justify-between gap-3">

                            <h2 class="text-xl leading-tight">
                                <a
                                    href="?pg=recipe&amp;slug={{ recipe.getRecipeSlugTitle()|url_encode }}"
                                >
                                    {{ recipe.getRecipeTitle() }}
                                </a>
                            </h2>

                            <span
                                class="text-xl text-[#b68d32]"
                                aria-hidden="true"
                            >
                                ♡
                            </span>

                        </div>

                        {# SÉPARATEUR #}
                        <div class="mt-5 border-t border-[#b68d32]"></div>

                        {# DURÉE ET DIFFICULTÉ #}
                        <div
                            class="mt-3 flex flex-wrap justify-between
                                   gap-2 text-xs"
                        >
                            <span>
                                ● Ready in {{ item.total_time }} mins
                            </span>

                            <span>
                                {{ recipe.getDifficulty()|capitalize }}
                            </span>
                        </div>

                    </article>

                {% endfor %}

            </section>

        {% endif %}

    </div>
</main>

{% endblock %}
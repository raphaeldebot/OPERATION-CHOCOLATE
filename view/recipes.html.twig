{% extends 'base.html.twig' %}
{% block body %}
<main class="mr-page mr-recipes">
    <section class="mr-recipes__banner" aria-labelledby="mr-recipes-title">
        <img src="assets/images/home/baking-scene.webp" alt="Ingrédients et préparation autour du chocolat" loading="lazy">
        <div class="mr-container mr-recipes__banner-copy">
            <p class="mr-eyebrow mr-eyebrow--light">Le carnet de la maison</p>
            <h1 id="mr-recipes-title">Toutes les recettes</h1>
            <p>Des douceurs chocolatées à réaliser et à partager.</p>
        </div>
    </section>

    <section class="mr-container mr-section" aria-label="Liste des recettes">
        {% if recipes_error|default(false) %}
            <p class="mr-notice" role="alert">Les recettes sont momentanément indisponibles.</p>
        {% elseif recipes|default([]) is empty %}
            <p class="mr-notice">Aucune recette disponible pour le moment.</p>
        {% else %}
            <div class="mr-section__heading">
                <div>
                    <p class="mr-eyebrow">À vous de cuisiner</p>
                    <h2>Choisissez votre douceur</h2>
                </div>
                <span class="mr-recipes__count">{{ recipes|length }} recette{{ recipes|length > 1 ? 's' : '' }}</span>
            </div>
            <div class="mr-card-grid mr-card-grid--catalogue">
                {% for item in recipes %}
                    {% set recipe = item.recipe %}
                    <article class="mr-recipe-card">
                        <a class="mr-recipe-card__media" href="?pg=recipe&amp;slug={{ recipe.getRecipeSlugTitle()|url_encode }}">
                            {% if recipe.getMainPic() %}
                                <img src="{{ recipe.getMainPic() }}" alt="{{ recipe.getRecipeTitle() }}" loading="lazy">
                            {% else %}
                                <div class="mr-recipe-card__placeholder">Photo à venir</div>
                            {% endif %}
                        </a>
                        <div class="mr-recipe-card__body">
                            <p class="mr-recipe-card__category">
                                {% for category in recipe.getCategories()|default([]) %}
                                    {{ category.getCategoryTitle() }}{% if not loop.last %} · {% endif %}
                                {% endfor %}
                            </p>
                            <h2><a href="?pg=recipe&amp;slug={{ recipe.getRecipeSlugTitle()|url_encode }}">{{ recipe.getRecipeTitle() }}</a></h2>
                            <p class="mr-recipe-card__rating">
                                {% if item.vote_count|default(0) > 0 %}
                                    <span aria-hidden="true">★</span> {{ item.average_rating|number_format(1, ',', ' ') }}/5
                                    <small>({{ item.vote_count }} avis)</small>
                                {% else %}
                                    <small>Pas encore de note</small>
                                {% endif %}
                            </p>
                            <p class="mr-recipe-card__facts"><span>◷ {{ item.total_time }} min</span><span>{{ recipe.getDifficulty()|capitalize }}</span></p>
                            <a class="mr-text-link" href="?pg=recipe&amp;slug={{ recipe.getRecipeSlugTitle()|url_encode }}">Voir la recette <span aria-hidden="true">→</span></a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</main>
{% endblock %}
